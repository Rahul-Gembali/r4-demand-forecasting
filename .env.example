# =============================================================================
# R4 Cold-Start Retail Demand Forecasting - Environment Configuration Template
# Copy this file to '.env' and adjust parameters for your target environment.
# NEVER commit production secrets or real API keys to version control.
# =============================================================================

# -----------------------------------------------------------------------------
# 1. Application Runtime Settings
# -----------------------------------------------------------------------------
# Environment: 'development', 'staging', or 'production'
# Note: 'production' enforces strict secret validation, HTTPS checks, and disallows SQLite
ENVIRONMENT=development
LOG_LEVEL=INFO
APP_HOST=0.0.0.0
APP_PORT=8000
API_PREFIX=/api/v1
WEB_CONCURRENCY=2

# Cryptographic secret key used for session signing and internal hashing
# MUST be changed to a cryptographically strong 32+ character random string in production
SECRET_KEY=change-this-to-a-secure-random-secret-key-in-production-32chars

# Allowed CORS origins (comma-separated URLs)
ALLOWED_ORIGINS=http://localhost,http://localhost:80,http://localhost:3000,http://localhost:5173

# -----------------------------------------------------------------------------
# 2. Database Connection
# -----------------------------------------------------------------------------
# Option A: Zero-dependency local SQLite (Recommended for rapid local dev & tests)
DATABASE_URL=sqlite+aiosqlite:///data/r4_forecast.db

# Option B: Production PostgreSQL (Required for multi-worker container deployments)
# DATABASE_URL=postgresql+asyncpg://postgres:postgres_secure_pass_2026@postgres:5432/r4_forecast_db

# PostgreSQL Container Defaults (used by docker-compose)
POSTGRES_DB=r4_forecast_db
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres_secure_pass_2026
POSTGRES_PORT=5432

# -----------------------------------------------------------------------------
# 3. Authentication & Role-Based Access Control (RBAC)
# -----------------------------------------------------------------------------
# Header: 'X-API-Key: <key>' or 'Authorization: Bearer <key>'
# ADMIN: Full permissions (data import, model training, promotions, forecasts)
API_KEY_ADMIN=r4-admin-key-2026-replace-me

# OPERATOR: Operational permissions (run forecasts, execute inventory optimizations)
API_KEY_OPERATOR=r4-operator-key-2026-replace-me

# VIEWER: Read-only access (query models, review forecasts, view dashboards and metrics)
API_KEY_VIEWER=r4-viewer-key-2026-replace-me

AUTH_ENABLED=true

# -----------------------------------------------------------------------------
# 4. Storage & File Uploads
# -----------------------------------------------------------------------------
MAX_UPLOAD_SIZE_BYTES=52428800
DATA_UPLOADS_DIR=./data/uploads

# -----------------------------------------------------------------------------
# 5. Database Initialization & Seeding Controls
# -----------------------------------------------------------------------------
# Set to 'true' to automatically execute schema init and load demo seed data on startup
RUN_DB_SEED=false

# Safety guard: set to 'true' ONLY if you explicitly want to allow seeding in a production environment
ALLOW_DEV_SEED=false

SEED_SALES_LIMIT=10000

# -----------------------------------------------------------------------------
# 6. Container Port Mappings (Docker Compose)
# -----------------------------------------------------------------------------
FRONTEND_PORT=80
BACKEND_PORT=8000
