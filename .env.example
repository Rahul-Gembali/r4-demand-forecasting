# ==============================================================================
# R4 New Product Demand Forecasting - Environment Configuration
# ==============================================================================

# Application Environment
ENVIRONMENT=development
LOG_LEVEL=INFO
APP_HOST=0.0.0.0
APP_PORT=8000
API_PREFIX=/api/v1

# Security & CORS
SECRET_KEY=r4-demand-forecasting-insecure-secret-key-change-in-prod
ALLOWED_ORIGINS=http://localhost:3000,http://localhost:5173

# PostgreSQL Database Configuration
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres
POSTGRES_SERVER=localhost
POSTGRES_PORT=5432
POSTGRES_DB=r4_forecast_db
DATABASE_URL=postgresql+asyncpg://postgres:postgres@localhost:5432/r4_forecast_db

# Data Storage Paths
DATA_RAW_DIR=./data/raw
DATA_PROCESSED_DIR=./data/processed
DATA_INTERIM_DIR=./data/interim
ARTIFACTS_DIR=./artifacts

# Forecasting & Evaluation Constraints
EVALUATION_HORIZON_WEEKS=8
NUM_EVALUATION_SKUS=150
APPROX_HISTORICAL_SKUS=1200
RANDOM_SEED=42
