# R4 Demand Forecasting Service Environment Configuration

# Application
ENVIRONMENT=development
LOG_LEVEL=INFO
APP_HOST=0.0.0.0
APP_PORT=8000
API_PREFIX=/api/v1
SECRET_KEY=dev-secret-key-change-in-production
ALLOWED_ORIGINS=http://localhost:3000,http://localhost:5173

# Database Connection
# SQLite for immediate zero-dependency offline development & testing:
DATABASE_URL=sqlite+aiosqlite:///data/r4_forecast.db
# PostgreSQL for production deployment:
# DATABASE_URL=postgresql+asyncpg://postgres:postgres@localhost:5432/r4_forecast_db

# Authentication Keys
API_KEY_ADMIN=r4-admin-key-2026
API_KEY_OPERATOR=r4-operator-key-2026
API_KEY_VIEWER=r4-viewer-key-2026
AUTH_ENABLED=true

# Storage & File Uploads
MAX_UPLOAD_SIZE_BYTES=52428800
DATA_UPLOADS_DIR=./data/uploads
